# SnapBase Environment Configuration
# Copy this file to .env and adjust variables as required.

# Gemini API Configuration (Multimodal Vision Engine)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Vision Model Name
GEMINI_MODEL=gemini-2.5-flash

# Default Extraction Engine: 'gemini' or 'ocr'
DEFAULT_ENGINE=ocr

# Database Connection URL (SQLite default)
DATABASE_URL=sqlite:///data/snapbase.db
