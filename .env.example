# ==============================================================================
# PIXELMIND: Dual-Mode AI Visual Intelligence Database
# Environment Configuration Template
# ==============================================================================

# 1. Operating Mode ('cloud' or 'local')
# - 'local': Uses YOLOv8n (CPU) + OpenCLIP ViT-B-32 with local file storage.
# - 'cloud': Uses Google Gemini 2.5 Flash + text-embedding-004 + Supabase Storage.
# (Automatically defaults to 'cloud' on Vercel serverless environments)
AI_MODE=local

# 2. Database Connection URL
# Local Default: sqlite:///data/pixelmind.db
# Cloud (Supabase / Neon PostgreSQL): postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres
# Cloud (MySQL / PlanetScale): mysql+pymysql://USER:PASS@HOST:3306/pixelmind
DB_URL=sqlite:///data/pixelmind.db

# 3. Google Gemini Vision & Semantic Embeddings
# Required for Cloud Mode. Free tier keys available at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# 4. Image Storage Backend ('local' or 'supabase')
# Local mode persists files to data/uploads/ and data/annotated/
# Cloud mode persists files to Supabase Storage via REST API
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos

# 5. Local Model & Detection Tuning (Optional)
CONFIDENCE_THRESHOLD=0.25
MAX_FILE_SIZE_BYTES=15728640
